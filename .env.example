# Copier ce fichier en `.env.local` et renseigner les valeurs.
# Sans NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY, le site affiche
# une page d'installation.

# URL publique du site (sans slash final). Sert aux liens des e-mails, aux
# redirections Mollie et au QR code des billets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service role : serveur uniquement, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Mollie (Dashboard → Developers → API keys). test_xxx en développement, live_xxx en production.
MOLLIE_API_KEY=

# SMTP pour les e-mails transactionnels (confirmation d'inscription + billet PDF)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true si le port est 465 (TLS implicite), false sinon
SMTP_SECURE=false
# Expéditeur no-reply, adresse de réponse (tournois) et boîte admin notifiée à chaque inscription
EMAIL_TOURNAMENT_FROM="Mister 8 Tournament League <no-reply@mister-8.com>"
EMAIL_TOURNAMENT_REPLY_TO=as@mister-8.com
EMAIL_TOURNAMENT_ADMIN_TO=as@mister-8.com
